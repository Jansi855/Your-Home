{
  "name": "your-home-calculators",
  "version": "1.0.0",
  "description": "Your Home - Real Estate Financial Calculators Portal & Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:backend": "node --watch server.js",
    "dev:frontend": "npm --prefix Frontend run dev",
    "build:frontend": "npm --prefix Frontend run build",
    "build": "npm run build:frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "keywords": [
    "real-estate",
    "calculator",
    "emi",
    "true-cost",
    "property",
    "finance"
  ],
  "author": "Your Home Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
